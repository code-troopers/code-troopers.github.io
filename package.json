{
  "name": "code-troopers-website",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine de Code-Troopers (Hugo + Webpack)",
  "repository": "github:code-troopers/code-troopers.github.io",
  "license": "MIT",
  "scripts": {
    "lint": "eslint src scripts",
    "start": "run-p 'start:**'",
    "start:hugo": "hugo -d ../dist -s site -w -D -F",
    "start:webpack": "webpack-dev-server --config webpack.dev.js --hot",
    "build": "yarn build:webpack && yarn build:hugo",
    "build:preview": "yarn build:webpack && yarn build:hugo -D -F",
    "build:hugo": "hugo -d ../dist -s site --panicOnWarning",
    "build:webpack": "cross-env NODE_ENV=production webpack --config webpack.prod.js",
    "check:content": "node scripts/check-content.mjs",
    "verify": "yarn lint && yarn check:content && yarn build"
  },
  "devDependencies": {
    "@babel/core": "^8",
    "@babel/preset-env": "^8",
    "assets-webpack-plugin": "^7.1.1",
    "autoprefixer": "^10.7.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8",
    "eslint": "^10",
    "globals": "^17",
    "hugo-extended": "~0.164.0",
    "js-yaml": "^4",
    "mini-css-extract-plugin": "^2.10.2",
    "npm-run-all2": "^9",
    "postcss": "^8.5.33",
    "postcss-custom-media": "^12",
    "postcss-import": "^17",
    "postcss-loader": "^8.2.2",
    "postcss-preset-env": "^11",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.108.2",
    "sass-loader": "^17",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.113.0",
    "webpack-cli": "^7",
    "webpack-dev-server": "^6",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "lightbox2": "^2.12.0"
  },
  "resolutions": {
    "adm-zip": "^0.6.0",
    "debug": "^4.3.7",
    "qs": "^6.15.3",
    "serialize-javascript": "^7.0.5",
    "ws": "^8.21.0"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  }
}
