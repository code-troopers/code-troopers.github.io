{
  "name": "code-troopers-website",
  "version": "1.0.0",
  "private": true,
  "description": "Site vitrine de Code-Troopers (Hugo + Webpack)",
  "repository": "github:code-troopers/code-troopers.github.io",
  "license": "MIT",
  "scripts": {
    "lint": "eslint src",
    "start": "run-p 'start:**'",
    "start:hugo": "hugo -d ../dist -s site -w -D -F",
    "start:webpack": "webpack-dev-server --config webpack.dev.js --hot",
    "build": "yarn build:webpack && yarn build:hugo",
    "build:preview": "yarn build:webpack && yarn build:hugo -D -F",
    "build:hugo": "hugo -d ../dist -s site --panicOnWarning",
    "build:webpack": "cross-env NODE_ENV=production webpack --config webpack.prod.js"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "assets-webpack-plugin": "^7.1.1",
    "autoprefixer": "^10.4.21",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.2",
    "eslint": "^9.37.0",
    "globals": "^16.5.0",
    "hugo-extended": "^0.164.0",
    "mini-css-extract-plugin": "^2.9.4",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.6",
    "postcss-custom-media": "^11.0.6",
    "postcss-import": "^16.1.1",
    "postcss-loader": "^8.2.0",
    "postcss-preset-env": "^10.4.0",
    "resolve-url-loader": "^5.0.0",
    "sass": "^1.93.2",
    "sass-loader": "^16.0.5",
    "terser-webpack-plugin": "^5.3.14",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "lightbox2": "^2.11.5"
  },
  "resolutions": {
    "adm-zip": "^0.6.0",
    "debug": "^4.3.7",
    "qs": "^6.15.3",
    "serialize-javascript": "^7.0.5",
    "ws": "^8.21.0"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=24"
  }
}
